{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    // "eslint.config.js", TODO https://github.com/TanStack/create-tsrouter-app/issues/80
    "vite.config.js"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    // ES2023 statt ES2022: die serverseitig eingebundenen Quellen aus
    // @repo/yt-notes-scripts nutzen Array.prototype.findLast /
    // findLastIndex. Nur die Typbibliothek — "target" bleibt ES2022.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun", "node"],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
